{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Warning"
      }

    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "4ExplainLogs\\Logs.json",
          "formatter": "Serilog.Formatting.Json.JsonFormatter,Serilog"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ],
    "Properties": {
      "ApplicationName": "4EPlatform-StrategicTelecom-Aggregator"
    }
  },
  "RateLimit": {
    "PermitLimit": 5,
    "QueueLimit": 5,
    "WindowSeconds": 10
  },
  "GrpcServiceSettings": {
    "UserManagmentUrl": "http://localhost:7152",
    "ControlPanelAggUrl": "http://localhost:7286",
    "orgUrl": "http://localhost:7286",
    "RiskManagement": "http://localhost:7299",
    "TicketingSystemUrl": "http://localhost:7201",
    "ServiceOperations": "http://localhost:7205"
  },
  "AllowedHosts": "*",
  "IdentityUrl": "http://localhost:5111/"
        }
       